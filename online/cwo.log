/*C5*/SET SCHEMA PUBLIC
drop table if exists "Roles"
drop table if exists "Logs"
drop table if exists "Games"
DISCONNECT
/*C6*/SET SCHEMA PUBLIC
create table "Games" ("name" LONGVARCHAR NOT NULL,"id" INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY)
create table "Logs" ("gameId" INTEGER NOT NULL,"index" INTEGER NOT NULL,"role" LONGVARCHAR NOT NULL,"value" LONGVARCHAR NOT NULL)
alter table "Logs" add constraint "LogsKey" primary key("gameId","index")
alter table "Logs" add constraint "LogsGames" foreign key("gameId") references "Games"("id") on update NO ACTION on delete NO ACTION
create table "Roles" ("gameId" INTEGER NOT NULL,"name" LONGVARCHAR NOT NULL,"secret" LONGVARCHAR NOT NULL)
alter table "Roles" add constraint "RolesKey" primary key("gameId","name")
alter table "Roles" add constraint "RolesGames" foreign key("gameId") references "Games"("id") on update NO ACTION on delete NO ACTION
DISCONNECT
