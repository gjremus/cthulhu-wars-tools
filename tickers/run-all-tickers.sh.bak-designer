#!/bin/zsh
# UNIFIED TICKER RUNNER: runs ALL tickers sequentially in one launchd job.
# Fires every 15 minutes. Each tick gets the master, homebrews, and FBE prompts
# executed one at a time — no parallel claude sessions, no API throttling.
#
# THIS IS THE ONLY TICKER MECHANISM. All individual per-ticker launchd jobs
# have been unloaded. If you need to restart:
#   launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.gremus.cw-ticker-unified.plist
# To stop:
#   launchctl bootout gui/$(id -u)/com.gremus.cw-ticker-unified

set -u

export HOME="/Users/gremus"
export NODE_EXTRA_CA_CERTS="/Users/gremus/.claude/certs/salesforce-ca-bundle.pem"
# TICKER PYTHON (2026-09-26): a self-contained, FDA-granted, uchg-locked CPython at a
# fixed owned path is FIRST on PATH so every `python3 …` the model runs (task-move.py,
# doc-edit.py, etc.) resolves to it. WHY: under launchd, Google Drive's File Provider
# BLOCKS open() forever for any process lacking Full Disk Access — and FDA does NOT
# inherit from the (FDA-granted) pinned claude to its Bash-spawned python3 child. So the
# interpreter itself must hold FDA. Apple's /usr/bin/python3 is a SIP stub replaced on OS
# updates (fragile grant); this standalone python we own+lock never changes, so its one
# GUI FDA grant persists forever. Grant target = .local/share/ticker-python/python/bin/python3.12
export PATH="/Users/gremus/.local/share/ticker-python/python/bin:/Users/gremus/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0

# PINNED CLAUDE BINARY (2026-09-25): the ticker runs a FIXED-PATH copy, NOT the
# auto-updating ~/.local/bin/claude symlink. macOS ties Full Disk Access to the
# exact binary file; the auto-updater installs each new version at a NEW path
# (~/.local/share/claude/versions/<ver>), so every update silently orphaned the
# FDA grant and the launchd tick then hung at startup waiting on an unanswerable
# TCC prompt ("claude failed to start 3x, startup deadlock, no output"). This
# fixed copy never moves, so FDA granted to it ONCE persists across every future
# update of the interactive claude. To refresh the ticker's claude deliberately:
#   cp -f "$(readlink -f ~/.local/bin/claude)" "$CLAUDE" && chmod +x "$CLAUDE"
# (same signing identity + same path == FDA grant is kept; no re-grant needed).
CLAUDE="/Users/gremus/.local/share/claude/ticker-claude-pinned"
TOOLS="/Users/gremus/Claude-Projects/cthulhu-wars-tools"
CW="/Users/gremus/Library/CloudStorage/GoogleDrive-gremus@salesforce.com/My Drive/Personal/Games/Cthulhu Wars"
LOCKFILE="/tmp/cw-ticker-unified.lock"

# Mutual exclusion: if another instance is already running, bail
if [[ -f "$LOCKFILE" ]]; then
    LOCK_PID=$(cat "$LOCKFILE" 2>/dev/null)
    if kill -0 "$LOCK_PID" 2>/dev/null; then
        echo "[$(date '+%F %T')] SKIP unified ticker — previous run (pid $LOCK_PID) still active" >> /tmp/cw-ticker-unified.history
        exit 0
    fi
    # Stale lock — previous run crashed
    rm -f "$LOCKFILE"
fi
echo $$ > "$LOCKFILE"
trap 'rm -f "$LOCKFILE"' EXIT

# ── DELETE-PROTECTION: OS-lock every live task doc before doing any work ──────
# Each live .docx/.xlsx carries the user-immutable flag (chflags uchg); the
# kernel then refuses ALL delete/overwrite/rename of it, so this ticker can
# NEVER destroy a task doc no matter what command it runs. This sweep re-locks
# everything each tick (idempotent) so any doc created since the last tick is
# protected too. The sanctioned surgical editors lift the flag ONLY for their
# own in-place write and restore it immediately; nothing else can (the docx
# guard hook blocks any shell/inline attempt to clear it).
"$TOOLS/tickers/cw-doclock.sh" lock-all >> /tmp/cw-ticker-unified.history 2>&1 || true

# ── WARM THE DRIVE CACHE: force-materialize every doc the ticks read ─────────
# 2026-08-19: Google Drive File Stream intermittently serves these docs as
# non-materialized ("dataless") placeholders. When that happens a plain read
# returns non-content and DEADLOCKS: task-move.py saw "File is not a zip file"
# and, worse, a claude Read of a dataless .docx hung for 16+ min and stalled the
# whole tick (the "ticker did nothing" symptom). Reading a file's full bytes is
# what triggers Drive's on-demand download, so we pull every ticker doc local
# here BEFORE any claude session runs. Each read is bounded to ~25s so a single
# file Drive refuses to fetch can never wedge the runner — it just gets skipped
# and that one tick degrades instead of hanging. Read-only; touches no content.
warm_file() {
    local f="$1"
    ( cat "$f" >/dev/null 2>&1 ) &
    local cp=$!
    ( sleep 25; kill -9 "$cp" 2>/dev/null ) &
    local wd=$!
    wait "$cp" 2>/dev/null
    kill "$wd" 2>/dev/null
}
# GENTLE WARM (2026-08-30): the old version force-read ALL 26 HomeBrews docs in a
# tight loop every cycle. That read-FLOOD was itself choking Google Drive's File
# Provider into the EDEADLK wedge this runner exists to avoid — verified live:
# 5/5 canary reads healthy, then a kickstart's warm-flood wedged Drive within
# seconds, and it recovered on its own ~1 min after the flood stopped. So we now
# warm ONLY the two small master files the master tick needs, one at a time with a
# breath between. The homebrews/FBE ticks materialize their own specific docs
# in-session (now bounded by the WEDGE-NOISE cap + per-tick preflight), so they no
# longer need — and must not trigger — a preemptive bulk warm that wedges Drive.
_warm_start=$(date '+%F %T'); _warm_n=0
for wf in "$CW/master current tasks.docx" "$CW/master current tasks.xlsx"; do
    [[ -f "$wf" ]] && { warm_file "$wf"; _warm_n=$((_warm_n+1)); sleep 1; }
done
echo "[$_warm_start] warmed Drive doc cache (${_warm_n} master files, gentle; bulk 26-file HomeBrews warm removed — it was wedging Drive)" \
    >> /tmp/cw-ticker-unified.history

# ── Progress-based watchdog (replaces the old fixed TICK_TIMEOUT hard kill) ──
# 2026-08-04: the old design force-killed every tick at a fixed 25 min, which
# butchered legitimately-long investigations mid-work (rc=143, "did nothing").
# Instead of a fixed cap we now watch for PROGRESS. The claude session runs in
# streaming mode, so its log file grows with every step it takes (each tool
# call and message is a "check-in"). The watchdog samples the log every
# PROGRESS_INTERVAL seconds; a tick is only killed if it makes NO progress
# (log stops growing entirely) for STALL_MAX_MISSES consecutive samples —
# i.e. a genuine hang, not slow-but-working. A long build or a slow SSH is
# fine as long as SOMETHING keeps happening within the window.
PROGRESS_INTERVAL="${PROGRESS_INTERVAL:-300}"   # sample every 5 min
STALL_MAX_MISSES="${STALL_MAX_MISSES:-4}"        # kill after 4 empty samples (= 20 min of total silence)
# Absolute backstop so a pathological loop that keeps emitting output can't run
# forever and hold the lockfile indefinitely. Set very high; normal ticks never
# reach it. Set to 0 to disable entirely.
MAX_WALL="${MAX_WALL:-7200}"                     # 2 h hard ceiling (safety only)

# ── DRIVE WEDGE HANDLING (2026-08-30) ────────────────────────────────────────
# The #1 "ticker did nothing for hours" failure: Google Drive's File Provider
# wedges (a large sync backlog freezes its threads), every read returns EDEADLK
# ("Resource deadlock avoided"), and the claude session then burns 30+ min
# retrying inside task-move.py / cw-materialize.py while the byte-growth stall
# detector mistakes the retry stderr for real progress. Two guards below turn
# that multi-hour hang into a fast, self-healing SKIP that retries next cycle:
#   1. drive_ready(): a HARD-KILLED (never-hanging) canary read BEFORE we spend a
#      whole session — skip the tick outright if Drive is wedged right now.
#   2. WEDGE_NOISE_MAX: if a running tick emits this many EDEADLK/materialize
#      retry lines, it's clearly just fighting a wedge — kill it and skip.
# NOTE: we deliberately do NOT shorten the 240s materialize budget — a genuine
# cold download of a large docx legitimately takes ~2 min; the canary here is the
# small master xlsx, which materializes fast, so a slow big doc never false-skips.
WEDGE_NOISE_MAX="${WEDGE_NOISE_MAX:-12}"         # kill a tick after this many Drive-retry lines
CANARY="$CW/master current tasks.xlsx"           # small, always-needed Drive health probe

# Returns 0 iff $1 fully reads to a valid payload within $2 seconds; 1 on
# wedge/timeout. A stuck File Provider thread can make a plain read() BLOCK (not
# just return EDEADLK), so the read runs in a child that is hard-killed after the
# window — this probe itself can NEVER hang the runner.
# NOTE (2026-08-30): drive_ready() is retained for reference but is NO LONGER
# CALLED. It reads the canary from THIS launchd shell, which lacks Full Disk
# Access to ~/Library/CloudStorage, so it always returns EPERM (errno 1) — a TCC
# denial, not a Drive-health signal. Do not re-wire it into the tick path. Drive
# wedges are handled by the in-session WEDGE-NOISE cap instead. See run_ticker.
drive_ready() {
    local f="$1" limit="${2:-40}"
    /usr/bin/python3 -c 'import sys; d=open(sys.argv[1],"rb").read(); sys.exit(0 if len(d)>=4 and d[:2]==b"PK" else 1)' "$f" 2>/dev/null &
    local cp=$!
    ( sleep "$limit"; kill -9 "$cp" 2>/dev/null ) &
    local wd=$!
    wait "$cp" 2>/dev/null; local rc=$?
    kill "$wd" 2>/dev/null; wait "$wd" 2>/dev/null
    return $rc
}

run_ticker() {
    local name="$1"
    local prompt_file="$2"
    local hist="/tmp/cw-ticker-${name}.history"
    local log="/tmp/cw-ticker-${name}.$(date '+%Y%m%d').log"

    if [[ ! -f "$prompt_file" ]]; then
        echo "[$(date '+%F %T')] SKIP   ticker=${name} (no prompt file)" >> "$hist"
        return 0
    fi

    # ── NO DRIVE PREFLIGHT (removed 2026-08-30) ──────────────────────────────
    # A preflight canary read was tried here and it BROKE the ticker: it spawned a
    # bare `/usr/bin/python3` DIRECTLY from this launchd shell to read the canary,
    # but a launchd agent has NO Full Disk Access to ~/Library/CloudStorage, so
    # that read ALWAYS fails with `PermissionError: [Errno 1] Operation not
    # permitted` — a TCC denial, NOT a Drive wedge. The result: every scheduled
    # tick false-skipped and the ticker "did nothing" for hours. (The `claude`
    # binary itself HAS Full Disk Access — that is why the in-session task-move.py
    # reads succeed while a bare launchd-spawned python cannot even open the file.)
    #
    # So we do NOT gate on a launchd-context read here. Genuine Drive WEDGES (the
    # Errno-11/EDEADLK case) are still handled cheaply: the claude session's own
    # task-move.py reads emit "materialize attempt N/30 / Errno 11" retry lines
    # into the stream, and the progress-watchdog's WEDGE-NOISE cap below KILLS the
    # tick fast once those cross WEDGE_NOISE_MAX — self-healing skip without a
    # multi-hour hang, and without needing a read the launchd shell can't do.

    echo "[$(date '+%F %T')] FIRED  ticker=${name}" >> "$hist"
    echo "===== [$(date '+%F %T')] ${name} tick start (progress watchdog: sample ${PROGRESS_INTERVAL}s, stall after ${STALL_MAX_MISSES} misses) =====" >> "$log"

    # WORKDIR MUST BE LOCAL DISK, NOT GOOGLE DRIVE (2026-08-12): claude scans its
    # cwd at startup; when cwd is the Google Drive CloudStorage path, one of those
    # syscalls hits Drive's virtual filesystem and is interrupted, and claude
    # aborts with "error: An internal error occurred (EINTR)" ~15s in — rc=1 every
    # tick, the ticker "did nothing" for weeks. Root-caused by launchd probe:
    # identical invocation with cwd=/tmp or ~/.cw-ticker-workdir → rc=0; with
    # cwd=Google-Drive ticker-workdir → EINTR. So we run from a LOCAL workdir.
    # The tickers reference every doc/tool/prompt by ABSOLUTE path, so cwd only
    # needs to be a stable local dir. Its .claude/settings.json re-registers the
    # docx guard hook for this project context.
    local WORKDIR="/Users/gremus/.cw-ticker-workdir"
    mkdir -p "$WORKDIR"
    cd "$WORKDIR" || { echo "[$(date '+%F %T')] ABORT  cd failed" >> "$hist"; return 1; }

    # Stream events to a live progress file so the watchdog can SEE progress.
    # --output-format stream-json --verbose emits one JSON line per step (tool
    # call, message, result), so this file grows continuously while the session
    # is actually doing anything. The human-readable summary is still appended
    # to $log at the end.
    local stream="/tmp/cw-ticker-${name}.stream.jsonl"

    # Model: claude-sonnet-5 (owner requested Sonnet, 2026-08-11). Use the
    # explicit id, NOT a bare alias: on the Bedrock/SF gateway "opus"/older
    # sonnet ids 401 ("Team not allowed to access model"). Verified accessible:
    # claude-sonnet-5 OK; claude-sonnet-4-5 is 401-blocked; claude-opus-4-8 OK.
    #
    # --strict-mcp-config: start with NO filesystem MCP servers for the tick (the
    # Salesforce Org62 connector hangs in the headless launchd context, and the
    # ticker needs zero Salesforce access). < /dev/null: never block waiting on
    # stdin under launchd.
    #
    # STARTUP-RETRY (2026-08-11): intermittently a launchd-spawned claude
    # deadlocks on an INTERNAL startup mutex before it ever emits its init line —
    # traced live: main thread parked in __ulock_wait with ZERO network sockets,
    # so it is NOT the API/MCP, just a flaky startup race. A freshly-launched
    # claude is healthy. So instead of letting the 20-min progress watchdog burn
    # a whole tick on a corpse (which is exactly why the ticker "did nothing"), we
    # watch for the FIRST byte of output within STARTUP_GRACE and, if none comes,
    # kill and RELAUNCH — up to STARTUP_RETRIES times. This self-heals the race.
    local STARTUP_GRACE="${STARTUP_GRACE:-90}"
    local STARTUP_RETRIES="${STARTUP_RETRIES:-3}"

    # STALL-RELAUNCH (2026-08-20): the __ulock_wait deadlock has a SECOND mode.
    # Some ticks PASS the startup gate (emit a few KB) and THEN freeze mid-run —
    # observed 2026-08-19: the master and homebrews ticks each reached ~5KB and
    # then went totally silent. The progress watchdog below already kills such a
    # corpse, but previously the tick was simply ABANDONED and, worse, the dead
    # run kept holding the lockfile so the next 15-min cron fire was skipped. A
    # fresh relaunch self-heals the deadlock (exactly like the startup case), so
    # a true stall-kill now RELAUNCHES the whole tick up to STALL_RETRIES times
    # instead of losing it. Bounded so a tick that reliably hangs on the same
    # operation cannot loop forever; the MAX_WALL backstop does NOT relaunch (a
    # 2-hour run is pathological, not a transient deadlock — abandon it as before).
    local STALL_RETRIES="${STALL_RETRIES:-2}"
    local stall_flag="/tmp/cw-ticker-${name}.stallkill"
    rm -f "$stall_flag" 2>/dev/null

    local CPID="" starts=0 stalls=0 RC=0
    while : ; do
        starts=$(( starts + 1 ))
        : > "$stream"
        rm -f "$stall_flag" 2>/dev/null
        # PROMPT PASSED INLINE, NOT VIA A "Read the file …" INSTRUCTION (2026-09-25).
        # We used to launch `-p "Read the file ${prompt_file} and follow it"`, which
        # made claude's FIRST action a Read tool call. Under LAUNCHD (but never from
        # an interactive shell) the follow-up model request that carries that ~24KB
        # file back as a tool_result HANGS indefinitely — parked, 0% CPU, one idle
        # socket — so every tick froze right after init at ~4KB and the watchdog
        # burned all its retries ("startup deadlock, no output"). Proven by launchd
        # one-shot probes: a trivial prompt and a small Bash round-trip both return
        # in seconds under launchd, the real "Read the file …" prompt always hangs,
        # and feeding the SAME prompt inline via $(cat …) runs normally under launchd
        # (reaches real task work in seconds). So we inline the prompt file's text as
        # the first user message — no initial Read round-trip, no hang. Keep it inline.
        "$CLAUDE" -p "$(cat "${prompt_file}")" \
            --permission-mode bypassPermissions \
            --model claude-sonnet-5 \
            --strict-mcp-config \
            --output-format stream-json --verbose \
            < /dev/null >> "$stream" 2>&1 &
        CPID=$!

        # ── STARTUP GATE ──────────────────────────────────────────────────────
        # Wait until the stream shows REAL progress within the grace window.
        # CRITICAL (2026-08-19): the __ulock_wait deadlock emits the init line
        # THEN freezes forever, so "first byte seen" is NOT proof of life — the
        # old `sz > 0` test accepted that corpse and dropped it into the 20-min
        # progress watchdog (this is why the ticker kept "doing nothing"). A
        # healthy claude reads the prompt + runs read-rules within seconds, so its
        # stream GROWS past the init line almost immediately; a post-init deadlock
        # stays frozen at exactly the init-line size. So require the stream to grow
        # AFTER its first non-zero reading. Frozen-at-init through the whole grace
        # window == the deadlock → relaunch (fresh launches self-heal in ~5s).
        local waited=0 started=0 sz=0 first_sz=0
        while [[ "$waited" -lt "$STARTUP_GRACE" ]]; do
            sleep 5; waited=$(( waited + 5 ))
            if ! kill -0 "$CPID" 2>/dev/null; then
                # Process exited inside the grace window. Distinguish a genuine
                # fast finish (produced a full streamed result) from a STARTUP
                # CRASH (e.g. the Drive-cwd EINTR: ~42 bytes, "error: ... EINTR").
                # A crash leaves near-empty output or the literal EINTR marker;
                # in that case DON'T accept it — fall through to the relaunch
                # path so it self-heals instead of silently failing the tick.
                sz=$(wc -c < "$stream" 2>/dev/null | tr -d ' '); [[ -z "$sz" ]] && sz=0
                if grep -q "EINTR" "$stream" 2>/dev/null || [[ "$sz" -lt 200 ]]; then
                    started=0   # startup crash — retry
                else
                    started=1   # real output then exited; let wait handle rc
                fi
                break
            fi
            sz=$(wc -c < "$stream" 2>/dev/null | tr -d ' '); [[ -z "$sz" ]] && sz=0
            if [[ "$sz" -gt 0 ]]; then
                if [[ "$first_sz" -eq 0 ]]; then
                    first_sz="$sz"        # init line landed — now demand growth
                elif [[ "$sz" -gt "$first_sz" ]]; then
                    started=1; break      # stream grew past init → genuinely working
                fi
            fi
        done

        if [[ "$started" -ne 1 ]]; then
            echo "[$(date '+%F %T')] STARTUP-HANG ticker=${name} start=${starts}/${STARTUP_RETRIES} pid=${CPID} — stream frozen at init line (no progress past first_sz=${first_sz} bytes) in ${STARTUP_GRACE}s; relaunching" >> "$hist"
            pkill -TERM -P "$CPID" 2>/dev/null; kill -TERM "$CPID" 2>/dev/null; sleep 3
            pkill -KILL -P "$CPID" 2>/dev/null; kill -KILL "$CPID" 2>/dev/null
            if [[ "$starts" -ge "$STARTUP_RETRIES" ]]; then
                echo "[$(date '+%F %T')] STARTUP-FAIL ticker=${name} — ${STARTUP_RETRIES} silent starts; skipping this tick" >> "$hist"
                echo "[$(date '+%F %T')] ${name}: claude failed to start ${STARTUP_RETRIES}x (startup deadlock, no output); tick skipped, will retry next cycle." >> /tmp/cw-ticker-alerts.txt
                return 1
            fi
            sleep 5
            continue
        fi

        # ── PROGRESS WATCHDOG ─────────────────────────────────────────────────
        # Kill ONLY on a genuine stall (no new output for STALL_MAX_MISSES
        # consecutive samples). Slow-but-working ticks are fine. On a STALL kill,
        # drop a flag so the loop below knows to RELAUNCH (self-heal). The MAX_WALL
        # backstop kills but does NOT set the flag (never relaunch a 2-hour run).
        (
            local misses=0
            local last_size=-1
            local elapsed=0
            while kill -0 "$CPID" 2>/dev/null; do
                sleep "$PROGRESS_INTERVAL"
                elapsed=$(( elapsed + PROGRESS_INTERVAL ))
                local size
                size=$(wc -c < "$stream" 2>/dev/null | tr -d ' ')
                [[ -z "$size" ]] && size=0
                # WEDGE-NOISE CAP: a wedged Drive makes task-move.py/cw-materialize.py
                # spew "materialize attempt N/30" + "Errno 11" endlessly, so the stream
                # keeps GROWING and the byte-progress check below never counts a stall —
                # this is exactly why wedged ticks used to hang for hours. Count the
                # retry-noise lines; once they cross WEDGE_NOISE_MAX the tick is clearly
                # just fighting a wedge, not doing work → kill it and DO NOT relaunch
                # (no stall_flag), so the next 15-min cron cycle retries once Drive drains.
                local noise
                noise=$(grep -acE "materialize attempt [0-9]+/|Errno 11|Resource deadlock avoided" "$stream" 2>/dev/null)
                [[ -z "$noise" ]] && noise=0
                if [[ "$noise" -ge "$WEDGE_NOISE_MAX" ]]; then
                    echo "[$(date '+%F %T')] WEDGE-KILL ticker=${name} pid=${CPID} — ${noise} Drive-retry lines (>=${WEDGE_NOISE_MAX}); stuck on wedged Drive, skipping (no relaunch)" >> "$hist"
                    echo "[$(date '+%F %T')] ${name}: killed mid-tick — Drive wedged (${noise} EDEADLK/materialize retries); SKIPPED this cycle, next 15-min cycle retries. (Do NOT restart Drive.)" >> /tmp/cw-ticker-alerts.txt
                    echo "===== [$(date '+%F %T')] ${name} WEDGE-KILL (Drive retry storm) =====" >> "$log"
                    pkill -TERM -P "$CPID" 2>/dev/null; kill -TERM "$CPID" 2>/dev/null
                    sleep 5
                    pkill -KILL -P "$CPID" 2>/dev/null; kill -KILL "$CPID" 2>/dev/null
                    break
                fi
                if [[ "$size" -gt "$last_size" ]]; then
                    # Progress made since last sample — reset the stall counter.
                    misses=0
                    last_size="$size"
                    echo "[$(date '+%F %T')] PROGRESS ticker=${name} bytes=${size} (elapsed ${elapsed}s)" >> "$hist"
                else
                    misses=$(( misses + 1 ))
                    echo "[$(date '+%F %T')] NO-PROGRESS ticker=${name} miss ${misses}/${STALL_MAX_MISSES} (bytes=${size}, elapsed ${elapsed}s)" >> "$hist"
                    if [[ "$misses" -ge "$STALL_MAX_MISSES" ]]; then
                        echo "[$(date '+%F %T')] STALL-KILL ticker=${name} pid=${CPID} — no progress for $(( STALL_MAX_MISSES * PROGRESS_INTERVAL ))s" >> "$hist"
                        echo "===== [$(date '+%F %T')] ${name} STALL-KILL (no progress) =====" >> "$log"
                        : > "$stall_flag"   # signal the run loop to relaunch (self-heal)
                        pkill -TERM -P "$CPID" 2>/dev/null; kill -TERM "$CPID" 2>/dev/null
                        sleep 10
                        pkill -KILL -P "$CPID" 2>/dev/null; kill -KILL "$CPID" 2>/dev/null
                        break
                    fi
                fi
                # Absolute safety backstop (0 = disabled). Does NOT set the stall
                # flag: a run this long is a pathological loop, not a transient
                # deadlock, so we abandon the tick rather than relaunch it.
                if [[ "$MAX_WALL" -gt 0 && "$elapsed" -ge "$MAX_WALL" ]]; then
                    echo "[$(date '+%F %T')] MAX-WALL-KILL ticker=${name} pid=${CPID} — hit ${MAX_WALL}s ceiling" >> "$hist"
                    echo "===== [$(date '+%F %T')] ${name} MAX-WALL-KILL =====" >> "$log"
                    pkill -TERM -P "$CPID" 2>/dev/null; kill -TERM "$CPID" 2>/dev/null
                    sleep 10
                    pkill -KILL -P "$CPID" 2>/dev/null; kill -KILL "$CPID" 2>/dev/null
                    break
                fi
            done
        ) &
        local WDPID=$!

        wait "$CPID"
        RC=$?

        kill "$WDPID" 2>/dev/null
        wait "$WDPID" 2>/dev/null

        # Fold the streamed session into the human-readable log for later reading.
        cat "$stream" >> "$log" 2>/dev/null

        # If the watchdog stall-killed a frozen tick, relaunch fresh (self-heal)
        # up to STALL_RETRIES times. MAX_WALL kills leave no flag → fall through.
        if [[ -f "$stall_flag" ]]; then
            rm -f "$stall_flag" 2>/dev/null
            stalls=$(( stalls + 1 ))
            if [[ "$stalls" -le "$STALL_RETRIES" ]]; then
                echo "[$(date '+%F %T')] STALL-RELAUNCH ticker=${name} stall=${stalls}/${STALL_RETRIES} — mid-tick freeze killed; relaunching fresh (self-heal)" >> "$hist"
                echo "===== [$(date '+%F %T')] ${name} STALL-RELAUNCH ${stalls}/${STALL_RETRIES} =====" >> "$log"
                sleep 5
                continue
            fi
            echo "[$(date '+%F %T')] STALL-FAIL ticker=${name} — ${STALL_RETRIES} mid-tick freezes; giving up this cycle" >> "$hist"
            echo "[$(date '+%F %T')] ${name}: tick kept freezing mid-run (${STALL_RETRIES} relaunches all stalled); skipped this cycle, will retry next tick." >> /tmp/cw-ticker-alerts.txt
        fi
        break
    done

    echo "===== [$(date '+%F %T')] ${name} tick done rc=${RC} =====" >> "$log"
    echo "[$(date '+%F %T')] DONE   ticker=${name} rc=${RC}" >> "$hist"

    return $RC
}

echo "[$(date '+%F %T')] UNIFIED ticker run START" >> /tmp/cw-ticker-unified.history

# Run in priority order: master first, then homebrews, then FBE
run_ticker "master" \
    "$TOOLS/tickers/prompt-master.txt"

run_ticker "homebrews" \
    "$TOOLS/tickers/prompt-homebrews.txt"

# After the homebrews tick, check whether any Faction Implementation Guide just
# became BUILD-READY (all sections Creator Audited + Section 3 populated). If so,
# fire a macOS notification so the attended Opus session does the build. This is
# READ-ONLY on the docs and never fails the run (script always exits 0).
# Uses the FDA-granted ticker python (2026-09-26) — it reads guide docs on Google
# Drive, and /usr/bin/python3 (no FDA) would BLOCK forever on the File Provider.
/Users/gremus/.local/share/ticker-python/python/bin/python3 "$TOOLS/tickers/check-build-ready.py" \
    >> /tmp/cw-ticker-buildready.log 2>&1 || true

run_ticker "fbe-tasks" \
    "$TOOLS/tickers/prompt-fbe-tasks.txt"

echo "[$(date '+%F %T')] UNIFIED ticker run DONE" >> /tmp/cw-ticker-unified.history
